# ── API Keys ──────────────────────────────────────────
# LegiScan (free tier: 30,000 calls/month)
# Get key at: https://legiscan.com/legiscan-api
LEGISCAN_API_KEY=your_legiscan_api_key_here

# OpenStates (free tier: 500 calls/day)
# Get key at: https://openstates.org/accounts/register/
OPENSTATES_API_KEY=your_openstates_api_key_here

# Anthropic Claude API
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Email Digest ───────────────────────────────────────
# Gmail SMTP (use an App Password, NOT your account password)
# Enable App Passwords at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_gmail_app_password

# Comma-separated list of digest recipients
DIGEST_RECIPIENTS=recipient1@org.com,recipient2@org.com

# ── Deployment ─────────────────────────────────────────
# Public URL of your deployed tracker (shown in email digests)
TRACKER_URL=https://yourorg.github.io/vet-tracker
